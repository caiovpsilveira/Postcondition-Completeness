package src.completeness.util;

public final class CompletenessUtil
{

// FIXME: make Equals for arrays strictly_pure
// They are getting some weird error with OpenJML

// NOTE: avoid using generics (?).
// In the dataset we want to make sure
// That the proper equality/deep clone is being used
// Also if not present, better to caught it earlier

// Also, float and double are using '==' checks. this will check exact binary equality.
// this is bad for floats and double, and you should usually account for epsilon

// Plain types (and String)

//@ assigns \nothing;
//@ ensures \result == (a == b);
//@ no_state
public static boolean Equals(boolean a, boolean b);

//@ assigns \nothing;
//@ ensures \result == (a == b);
//@ no_state
public static boolean Equals(char a, char b);

//@ assigns \nothing;
//@ ensures \result == (a == b);
//@ no_state
public static boolean Equals(short a, short b);

//@ assigns \nothing;
//@ ensures \result == (a == b);
//@ no_state
public static boolean Equals(int a, int b);

//@ assigns \nothing;
//@ ensures \result == (a == b);
//@ no_state
public static boolean Equals(long a, long b);

//@ assigns \nothing;
//@ ensures \result == (a == b);
//@ no_state
public static boolean Equals(float a, float b);

//@ assigns \nothing;
//@ ensures \result == (a == b);
//@ no_state
public static boolean Equals(double a, double b);

//@ assigns \nothing;
//@ ensures \result <==> (a == b || (a != null && b != null && a.equals(b)));
//@ pure
public static boolean Equals(String a, String b);

// Arrays
//@ assigns \nothing;
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; Equals(a[i], b[i]))));
//FIXME below is redundant, but otherwise OpenJML struggles
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; a[i] == b[i])));
//@ pure
public static boolean Equals(boolean[] a, boolean[] b);

//@ assigns \nothing;
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; Equals(a[i], b[i]))));
//FIXME below is redundant, but otherwise OpenJML struggles
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; a[i] == b[i])));
//@ pure
public static boolean Equals(char[] a, char[] b);

//@ assigns \nothing;
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; Equals(a[i], b[i]))));
//FIXME below is redundant, but otherwise OpenJML struggles
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; a[i] == b[i])));
//@ pure
public static boolean Equals(short[] a, short[] b);

//@ assigns \nothing;
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; Equals(a[i], b[i]))));
//FIXME below is redundant, but otherwise OpenJML struggles
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; a[i] == b[i])));
//@ pure
public static boolean Equals(int[] a, int[] b);

//@ assigns \nothing;
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; Equals(a[i], b[i]))));
//FIXME below is redundant, but otherwise OpenJML struggles
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; a[i] == b[i])));
//@ pure
public static boolean Equals(long[] a, long[] b);

//@ assigns \nothing;
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; Equals(a[i], b[i]))));
//FIXME below is redundant, but otherwise OpenJML struggles
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; a[i] == b[i])));
//@ pure
public static boolean Equals(float[] a, float[] b);

//@ assigns \nothing;
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; Equals(a[i], b[i]))));
//FIXME below is redundant, but otherwise OpenJML struggles
//@ ensures \result <==> (a == b || (a != null && b != null && a.length == b.length && (\forall int i; 0 <= i < a.length; a[i] == b[i])));
//@ pure
public static boolean Equals(double[] a, double[] b);

